VALIO_API_KEY=
VALIO_API_BASE=https://junction26.valioaimo.fi
ANTHROPIC_API_KEY=

# Agent gateway (MCP). Agents authenticate with an API key that maps to an agent and a customer.
# Unset = one demo key, "aimo-demo-agent-key" → procurement-agent buying for helsinki-juhlapalvelu.
# Set but invalid = no key works (fails closed; the error is logged).
# AIMO_AGENT_KEYS={"<key, at least 8 chars>":{"agentId":"procurement-agent","customerId":"helsinki-juhlapalvelu","displayName":"Helsinki Juhlapalvelu purchasing agent"}}
# Key the stdio MCP server acts as (src/mcp/stdio.ts). HTTP clients send Authorization: Bearer <key> instead.
# AIMO_AGENT_KEY=aimo-demo-agent-key
# Model for all agents (Mastra model-router string). Default anthropic/claude-opus-5-5; e.g. openai/<model> with OPENAI_API_KEY.
# AIMO_MODEL=anthropic/claude-opus-5-5
# Where the app runs, for scripts/gateway-demo.ts --http, the approval link and scripts/mcp-only-proxy.ts.
# AIMO_BASE_URL=http://localhost:3100
# Extra browser origins allowed to call /api/mcp (comma-separated). Requests without Origin (non-browser clients) always pass.
# AIMO_ALLOWED_ORIGINS=
